{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error"
      }
    },
    "schemas": {
      "AgentCredential": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "id",
          "name"
        ],
        "type": "object"
      },
      "AgentCredentials": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AgentCredential"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "BackupReport": {
        "additionalProperties": false,
        "properties": {
          "last_backup": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/BackupStatus"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "BackupStatus": {
        "enum": [
          "complete",
          "app_only",
          "outdated",
          "missing",
          "unavailable",
          "standalone"
        ],
        "type": "string"
      },
      "Check": {
        "properties": {
          "message": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "message",
          "status"
        ],
        "type": "object"
      },
      "CheckStatus": {
        "enum": [
          "pass",
          "attention",
          "unavailable",
          "not_applicable"
        ],
        "type": "string"
      },
      "CreateAgent": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateShipment": {
        "additionalProperties": false,
        "properties": {
          "merchant": {
            "nullable": true,
            "type": "string"
          },
          "order_reference": {
            "nullable": true,
            "type": "string"
          },
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Source"
              }
            ],
            "nullable": true
          },
          "title": {
            "type": "string"
          },
          "tracking": {
            "additionalProperties": false,
            "default": {
              "carrier": null,
              "number": ""
            },
            "properties": {
              "carrier": {
                "nullable": true,
                "type": "string"
              },
              "number": {
                "default": "",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "CreatedAgentCredential": {
        "description": "The plaintext credential is returned only by creation, never by listing.",
        "properties": {
          "credential": {
            "$ref": "#/components/schemas/AgentCredential"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "credential",
          "token"
        ],
        "type": "object"
      },
      "Error": {
        "description": "Error information from a response.",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ],
        "type": "object"
      },
      "Event": {
        "properties": {
          "actor_id": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "shipment_id": {
            "format": "uuid",
            "type": "string"
          },
          "snapshot": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Shipment_for_Nullable_Tracking"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "actor_id",
          "at",
          "detail",
          "id",
          "kind",
          "shipment_id"
        ],
        "type": "object"
      },
      "EventKind": {
        "enum": [
          "created",
          "updated",
          "source_added",
          "override_set",
          "override_cleared",
          "archived",
          "restored",
          "refresh_requested",
          "carrier_updated"
        ],
        "type": "string"
      },
      "EventResultsPage": {
        "description": "A single page of results",
        "properties": {
          "items": {
            "description": "list of items on this page of results",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array"
          },
          "next_page": {
            "description": "token used to fetch the next page of results (if any)",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "InstallationReport": {
        "properties": {
          "authentication": {
            "$ref": "#/components/schemas/Check"
          },
          "backend": {
            "$ref": "#/components/schemas/Check"
          },
          "backup": {
            "$ref": "#/components/schemas/Check"
          },
          "easypost": {
            "$ref": "#/components/schemas/Check"
          },
          "integration": {
            "$ref": "#/components/schemas/Check"
          },
          "last_backup": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          }
        },
        "required": [
          "authentication",
          "backend",
          "backup",
          "easypost",
          "integration"
        ],
        "type": "object"
      },
      "IntegrationPresence": {
        "additionalProperties": false,
        "properties": {
          "backup": {
            "$ref": "#/components/schemas/BackupReport"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "backup",
          "version"
        ],
        "type": "object"
      },
      "SetOverride": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "reason",
          "status"
        ],
        "type": "object"
      },
      "Shipment_for_Nullable_Tracking": {
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "carrier_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Status"
              }
            ],
            "nullable": true
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "merchant": {
            "nullable": true,
            "type": "string"
          },
          "order_reference": {
            "nullable": true,
            "type": "string"
          },
          "revision": {
            "format": "int64",
            "type": "integer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "status_override": {
            "allOf": [
              {
                "$ref": "#/components/schemas/StatusOverride"
              }
            ],
            "nullable": true
          },
          "sync": {
            "$ref": "#/components/schemas/SyncState"
          },
          "title": {
            "type": "string"
          },
          "tracking": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Tracking"
              }
            ],
            "nullable": true
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "archived",
          "created_at",
          "id",
          "revision",
          "sources",
          "status",
          "sync",
          "title",
          "updated_at"
        ],
        "type": "object"
      },
      "Shipment_for_Tracking": {
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "carrier_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Status"
              }
            ],
            "nullable": true
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "merchant": {
            "nullable": true,
            "type": "string"
          },
          "order_reference": {
            "nullable": true,
            "type": "string"
          },
          "revision": {
            "format": "int64",
            "type": "integer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "status_override": {
            "allOf": [
              {
                "$ref": "#/components/schemas/StatusOverride"
              }
            ],
            "nullable": true
          },
          "sync": {
            "$ref": "#/components/schemas/SyncState"
          },
          "title": {
            "type": "string"
          },
          "tracking": {
            "$ref": "#/components/schemas/Tracking"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "archived",
          "created_at",
          "id",
          "revision",
          "sources",
          "status",
          "sync",
          "title",
          "tracking",
          "updated_at"
        ],
        "type": "object"
      },
      "Shipment_for_TrackingResultsPage": {
        "description": "A single page of results",
        "properties": {
          "items": {
            "description": "list of items on this page of results",
            "items": {
              "$ref": "#/components/schemas/Shipment_for_Tracking"
            },
            "type": "array"
          },
          "next_page": {
            "description": "token used to fetch the next page of results (if any)",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Source": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "namespace"
        ],
        "type": "object"
      },
      "Status": {
        "enum": [
          "expected",
          "unknown",
          "pre_transit",
          "in_transit",
          "out_for_delivery",
          "available_for_pickup",
          "delivered",
          "return_to_sender",
          "failure",
          "cancelled",
          "error"
        ],
        "type": "string"
      },
      "StatusOverride": {
        "properties": {
          "actor_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "set_at": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "actor_id",
          "reason",
          "set_at",
          "status"
        ],
        "type": "object"
      },
      "Summary": {
        "properties": {
          "active": {
            "format": "int64",
            "type": "integer"
          },
          "delivered": {
            "format": "int64",
            "type": "integer"
          },
          "exceptions": {
            "format": "int64",
            "type": "integer"
          },
          "expected": {
            "format": "int64",
            "type": "integer"
          },
          "in_transit": {
            "format": "int64",
            "type": "integer"
          },
          "out_for_delivery": {
            "format": "int64",
            "type": "integer"
          },
          "sync_errors": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "active",
          "delivered",
          "exceptions",
          "expected",
          "in_transit",
          "out_for_delivery",
          "sync_errors"
        ],
        "type": "object"
      },
      "SyncState": {
        "properties": {
          "attempts": {
            "format": "int64",
            "type": "integer"
          },
          "last_error": {
            "nullable": true,
            "type": "string"
          },
          "last_success_at": {
            "nullable": true,
            "type": "string"
          },
          "next_attempt_at": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "tracker_id": {
            "nullable": true,
            "type": "string"
          },
          "tracking_url": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "attempts"
        ],
        "type": "object"
      },
      "System": {
        "properties": {
          "credential_role": {
            "type": "string"
          },
          "pending_syncs": {
            "format": "int64",
            "type": "integer"
          },
          "provider_enabled": {
            "type": "boolean"
          },
          "sync_errors": {
            "format": "int64",
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "credential_role",
          "pending_syncs",
          "provider_enabled",
          "sync_errors",
          "version"
        ],
        "type": "object"
      },
      "Tracking": {
        "additionalProperties": false,
        "properties": {
          "carrier": {
            "nullable": true,
            "type": "string"
          },
          "number": {
            "default": "",
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateShipment": {
        "additionalProperties": false,
        "properties": {
          "merchant": {
            "nullable": true,
            "type": "string"
          },
          "order_reference": {
            "nullable": true,
            "type": "string"
          },
          "title": {
            "nullable": true,
            "type": "string"
          },
          "tracking": {
            "$ref": "#/components/schemas/Tracking"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Persistent local shipment records, manual corrections, and carrier synchronization. Use a Bearer owner or ingestion token. Creates require Idempotency-Key; writes to an existing shipment require its quoted revision in If-Match.",
    "title": "Shipments API",
    "version": "0.3.1"
  },
  "openapi": "3.0.3",
  "paths": {
    "/": {
      "get": {
        "operationId": "index",
        "responses": {
          "default": {
            "content": {
              "*/*": {
                "schema": {}
              }
            },
            "description": ""
          }
        },
        "tags": [
          "web"
        ]
      }
    },
    "/app.js": {
      "get": {
        "operationId": "script",
        "responses": {
          "default": {
            "content": {
              "*/*": {
                "schema": {}
              }
            },
            "description": ""
          }
        },
        "tags": [
          "web"
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "schema",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "successful operation"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/style.css": {
      "get": {
        "operationId": "style",
        "responses": {
          "default": {
            "content": {
              "*/*": {
                "schema": {}
              }
            },
            "description": ""
          }
        },
        "tags": [
          "web"
        ]
      }
    },
    "/v1/agents": {
      "get": {
        "operationId": "agents_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCredentials"
                }
              }
            },
            "description": "successful operation",
            "headers": {
              "cache-control": {
                "required": true,
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "List active agents without exposing their credentials or credential hashes.",
        "tags": [
          "agents"
        ]
      },
      "post": {
        "operationId": "agents_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAgent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedAgentCredential"
                }
              }
            },
            "description": "successful creation",
            "headers": {
              "cache-control": {
                "required": true,
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Generate a separate ingestion credential. The token is returned only once.",
        "tags": [
          "agents"
        ]
      }
    },
    "/v1/agents/{id}": {
      "delete": {
        "operationId": "agent_revoke",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Revoke one agent. Subsequent authentications consult the database directly.",
        "tags": [
          "agents"
        ]
      }
    },
    "/v1/installation": {
      "get": {
        "operationId": "installation",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationReport"
                }
              }
            },
            "description": "successful operation"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Read local installation checks without contacting EasyPost.",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/installation/check": {
      "post": {
        "operationId": "installation_check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationReport"
                }
              }
            },
            "description": "successful operation"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Explicitly check EasyPost using a read-only request, cached for one minute.",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/integration/presence": {
      "post": {
        "operationId": "integration_presence",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntegrationPresence"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Report a successful integration poll and its Supervisor backup inventory.",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/shipments": {
      "get": {
        "operationId": "shipments_list",
        "parameters": [
          {
            "description": "Filter by whether the effective status is nonterminal.",
            "in": "query",
            "name": "active",
            "schema": {
              "nullable": true,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "archived",
            "schema": {
              "nullable": true,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "carrier",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Maximum number of items returned by a single call",
            "in": "query",
            "name": "limit",
            "schema": {
              "format": "uint32",
              "minimum": 1,
              "nullable": true,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "order_reference",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Token returned by previous call to retrieve the subsequent page",
            "in": "query",
            "name": "page_token",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source_key",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source_namespace",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "$ref": "#/components/schemas/Status"
            }
          },
          {
            "in": "query",
            "name": "tracking_number",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shipment_for_TrackingResultsPage"
                }
              }
            },
            "description": "successful operation"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
